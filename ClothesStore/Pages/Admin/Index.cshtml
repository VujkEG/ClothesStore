@page "/admin/{*catchall}"
@using Microsoft.AspNetCore.Components.Web
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;

    bool dopusteno = User.Identity != null && User.Identity.IsAuthenticated &&
                     (User.IsInRole("Admins") ||
                      string.Equals(User.Identity?.Name, "Admin", StringComparison.OrdinalIgnoreCase) ||
                      string.Equals(User.Identity?.Name, "Administrator", StringComparison.OrdinalIgnoreCase));

    if (!dopusteno)
    {
        HttpContext.Response.Redirect("/");
        return;
    }
}

<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClothesStore - LOGIN</title>
    <base href="/" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <component type="typeof(HeadOutlet)" render-mode="Server" />
</head>
<body class="bg-light">

    <component type="typeof(ClothesStore.Pages.Admin.Routed)" render-mode="Server" />

    <div id="blazor-error-ui" style="display:none;" class="bg-danger text-white p-2 position-fixed bottom-0 start-0 w-100 text-center">
        Došlo je do greške. <a href="" class="reload text-white fw-bold">Osveži</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>