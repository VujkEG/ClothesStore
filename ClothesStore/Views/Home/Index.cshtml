@using ClothesStore.Models.ViewModels
@model ProductsListViewModel

@functions {
    public string GetProductImage(string name)
    {
        return name switch
        {
            "Oversized bela majica" => "https://images.unsplash.com/photo-1527719327859-c6ce80353573?w=600&auto=format&fit=crop&q=80",
            "Bordo torbica" => "https://images.unsplash.com/photo-1594633313593-bab3825d0caf?w=600&auto=format&fit=crop&q=80",
            "Crni duks bez kapuljače" => "https://images.unsplash.com/photo-1614975059251-992f11792b9f?w=600&q=80",
            "Narandzasti duks bez kapuljače" => "https://images.unsplash.com/photo-1578587018452-892bacefd3f2?w=600&auto=format&fit=crop&q=80",
            "Kožna jakna" => "https://images.unsplash.com/photo-1551028719-00167b16eac5?w=600&auto=format&fit=crop&q=80",
            "Zimska parka jakna" => "https://images.unsplash.com/photo-1510379872535-9310dc6fd6a7?w=600&auto=format&fit=crop&q=80",
            "Teksas jakna klasična" => "https://images.unsplash.com/photo-1543076447-215ad9ba6923?w=600&auto=format&fit=crop&q=80",
            "Slim-fit plave farmerke" => "https://images.unsplash.com/photo-1541099649105-f69ad21f3246?w=600&auto=format&fit=crop&q=80",
            "Crne kargo pantalone" => "https://images.unsplash.com/photo-1517445312882-bc9910d016b7?w=600&auto=format&fit=crop&q=80",
            "Sportske patike" => "https://images.unsplash.com/photo-1542291026-7eec264c27ff?w=600&auto=format&fit=crop&q=80",
            "Kožne jesenje cipele" => "https://images.unsplash.com/photo-1614252235316-8c857d38b5f4?w=600&auto=format&fit=crop&q=80",
            _ => "https://images.unsplash.com/photo-1472851294608-062f824d288b?w=600&q=80"
        };
    }
}

<style>
    body {
        background-color: #f8f9fa;
        background-image: radial-gradient(#dee2e6 0.5px, transparent 0.5px), radial-gradient(#dee2e6 0.5px, #f8f9fa 0.5px);
        background-size: 20px 20px;
        background-position: 0 0, 10px 10px;
    }

    html {
        scroll-behavior: smooth;
    }

    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield;
    }

    .premium-hero {
        background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.9) 100%), url('https://images.unsplash.com/photo-1441986300917-64674bd600d8?w=1600&q=80');
        background-size: cover;
        background-position: center;
        background-attachment: fixed;
        min-height: 60vh;
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    .hero-glow {
        position: absolute;
        top: -50%;
        left: -30%;
        width: 800px;
        height: 800px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, transparent 70%);
        z-index: 1;
        pointer-events: none;
    }

    .btn-premium-shop {
        background: linear-gradient(90deg, #6366f1 0%, #4f46e5 100%);
        color: white;
        font-weight: 600;
        border: none;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
        box-shadow: 0 10px 20px rgba(79, 70, 229, 0.3);
    }

        .btn-premium-shop:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 25px rgba(79, 70, 229, 0.4);
            color: white;
        }

    .product-img-wrapper {
        height: 260px;
        overflow: hidden;
        position: relative;
        background-color: #ffffff;
        cursor: pointer;
    }

    .product-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .card {
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(0,0,0,0.03) !important;
    }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08) !important;
        }

            .card:hover .product-img {
                transform: scale(1.08);
            }

    .modal-content {
        border: none;
        border-radius: 20px;
        overflow: hidden;
    }

    .modal-img-container {
        max-height: 550px;
        background-color: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .modal-img {
        width: 100%;
        max-height: 550px;
        object-fit: contain;
    }

    .btn-success-animated {
        background-color: #198754 !important;
        border-color: #198754 !important;
        color: white !important;
    }
</style>

@if (Model.CurrentCategory == null && Model.PagingInfo.CurrentPage == 1)
{
    <div class="premium-hero p-5 mb-5 rounded-4 shadow border-0 text-white">
        <div class="hero-glow"></div>
        <div class="position-relative w-100" style="z-index: 2; max-width: 700px;">
            <span class="badge bg-indigo mb-3 px-3 py-2 rounded-pill fw-bold text-uppercase tracking-wider" style="background-color: #6366f1; font-size: 0.75rem;">
                <i class="fas fa-sparkles me-1"></i> Nova Kolekcija 2026
            </span>
            <h1 class="display-4 fw-extrabold mb-3 text-white" style="font-weight: 800; letter-spacing: -1.5px;">Premium stil krojen za Vas</h1>
            <p class="text-white-50 fs-5 mb-4 lh-base">
                Otkrijte savršen spoj komfora i modernog dizajna. Naš asortiman donosi pažljivo odabrane materijale i krojeve koji ističu Vašu autentičnost.
            </p>
            <a href="#katalog-proizvoda" class="btn btn-premium-shop btn-lg px-4 py-3 rounded-pill d-inline-flex align-items-center gap-2">
                <i class="fas fa-shopping-bag"></i> Pogledaj artikle
            </a>
        </div>
    </div>
}

<div class="row g-4" id="katalog-proizvoda">
    <div class="col-12">
        <div class="bg-white p-3 rounded-4 shadow-sm d-flex align-items-center justify-content-between mb-2">
            <h4 class="fw-bold m-0 text-dark text-uppercase tracking-wide" style="font-size: 1.1rem; letter-spacing: 0.5px;">
                <i class="fas fa-align-left text-primary me-2"></i>
                @(Model.CurrentCategory ?? "Kompletna ponuda")
            </h4>
            <span class="badge bg-dark rounded-pill px-3 py-2 fw-semibold">Artikala: @Model.Products.Count()</span>
        </div>
    </div>

    @if (!Model.Products.Any())
    {
        <div class="col-12 text-center py-5 bg-white rounded-4 shadow-sm">
            <div class="display-1 text-muted mb-3"><i class="fas fa-box-open"></i></div>
            <h5 class="fw-bold text-secondary">Trenutno nema proizvoda.</h5>
        </div>
    }
    else
    {
        @foreach (var p in Model.Products)
        {
            var stockBadgeHtml = p.Stock <= 0
            ? "<span class='badge bg-danger-subtle text-danger px-3 py-2 rounded-3 fw-bold w-100'><i class='fas fa-times-circle me-1'></i> Rasprodato</span>"
            : p.Stock <= 5
            ? $"<span class='badge bg-warning-subtle text-warning px-3 py-2 rounded-3 fw-bold w-100'><i class='fas fa-exclamation-triangle me-1'></i> Samo još {p.Stock} kom!</span>"
            : $"<span class='badge bg-success-subtle text-success px-3 py-2 rounded-3 fw-bold w-100'><i class='fas fa-check-circle me-1'></i> Na stanju ({p.Stock})</span>";

            <div class="col-md-6 col-lg-4">
                <div class="card h-100 bg-white rounded-4 shadow-sm border-0 overflow-hidden d-flex flex-column">

                    <div class="product-img-wrapper border-bottom"
                         data-bs-toggle="modal"
                         data-bs-target="#productDetailsModal"
                         data-bs-id="@p.ProductID"
                         data-bs-stockcount="@p.Stock"
                         data-bs-name="@p.Name"
                         data-bs-img="@GetProductImage(p.Name)"
                         data-bs-category="@p.Category"
                         data-bs-desc="@p.Description"
                         data-bs-price="@p.Price.ToString("N0") RSD"
                         data-bs-stock="@stockBadgeHtml">

                        <img src="@GetProductImage(p.Name)" class="product-img" alt="@p.Name" loading="lazy" />
                        <span class="position-absolute top-3 start-3 badge bg-dark bg-opacity-75 text-white px-2 py-1 rounded-pill small fw-semibold" style="font-size: 0.75rem; backdrop-filter: blur(4px);">
                            @p.Category
                        </span>
                        <div class="position-absolute bottom-3 end-3 bg-white bg-opacity-75 rounded-circle d-flex align-items-center justify-content-center shadow-sm" style="width: 36px; height: 36px; backdrop-filter: blur(4px);">
                            <i class="fas fa-expand-alt text-dark small"></i>
                        </div>
                    </div>

                    <div class="card-body p-3 d-flex flex-column flex-grow-1">
                        <h5 class="fw-bold text-dark mb-1 text-truncate" title="@p.Name">@p.Name</h5>
                        <p class="text-muted small flex-grow-1 lh-sm mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @p.Description
                        </p>

                        <div class="mb-3">
                            @Html.Raw(stockBadgeHtml)
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-auto pt-2 border-top">
                            <span class="fs-5 fw-bold text-primary">@p.Price.ToString("N0") <span class="small" style="font-size: 0.75rem; color: #6c757d;">RSD</span></span>

                            @if (p.Stock > 0)
                            {
                                <form action="/Cart/AddToCart" method="post" class="ajax-cart-form d-flex align-items-center gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@p.ProductID" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.PathAndQuery()" />
                                    <button type="submit" class="btn btn-dark rounded-pill px-3 btn-sm d-flex align-items-center gap-1 shadow-sm transition-all">
                                        <i class="fas fa-shopping-cart" style="font-size: 0.8rem;"></i> <span>Kupi</span>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>

                </div>
            </div>
        }
    }
</div>

@if (Model.PagingInfo.TotalPages > 1)
{
    <div class="row mt-5">
        <div class="col-12 d-flex justify-content-center">
            <nav>
                <ul class="pagination pagination-md shadow-sm rounded-pill overflow-hidden">
                    @for (int i = 1; i <= Model.PagingInfo.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.PagingInfo.CurrentPage ? "active" : "")">
                            <a class="page-link px-3 py-2 border-0 fw-bold" href="@Url.Action("Index", new { category = Model.CurrentCategory, productPage = i })">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    </div>
}

<div class="modal fade" id="productDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content shadow-lg bg-white">
            <div class="modal-header border-0 pb-0 d-flex justify-content-end">
                <button type="button" class="btn-close shadow-none close-modal-trigger" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close" style="font-size: 1.2rem; cursor: pointer; z-index: 9999;"></button>
            </div>
            <div class="modal-body pt-0">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="modal-img-container rounded-3 border">
                            <img id="modalProductImg" src="" class="modal-img" alt="Proizvod" />
                        </div>
                    </div>
                    <div class="col-md-6 d-flex flex-column justify-content-between">
                        <div>
                            <span id="modalProductCategory" class="badge bg-secondary mb-2 px-2 py-1 rounded"></span>
                            <h3 id="modalProductTitle" class="fw-bold text-dark mb-3"></h3>
                            <div id="modalProductStock" class="mb-3"></div>
                            <h5 class="fw-semibold text-secondary small text-uppercase mb-2">Opis Proizvoda</h5>
                            <p id="modalProductDesc" class="text-muted lh-base small" style="white-space: pre-line;"></p>
                        </div>

                        <div class="pt-3 border-top mt-4">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="text-muted small">Cijena artikla:</span>
                                <h3 id="modalProductPrice" class="fw-bold text-primary m-0"></h3>
                            </div>

                            <form id="modalAddToCartForm" action="/Cart/AddToCart" method="post" class="ajax-cart-form d-flex gap-2 mb-2">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" id="modalProductId" value="" />
                                <input type="hidden" name="returnUrl" value="@ViewContext.HttpContext.Request.PathAndQuery()" />

                                <div class="d-flex align-items-center border rounded-pill bg-light p-1" style="width: 120px; height: 44px;">
                                    <button type="button" id="btnMinus" class="btn btn-light h-100 border-0 rounded-circle fw-bold text-dark d-flex align-items-center justify-content-center p-0" style="width: 32px; font-size: 1.2rem;">-</button>
                                    <input type="number" name="quantity" id="modalProductQty" class="form-control text-center border-0 bg-transparent fw-bold p-0 text-dark h-100 m-0" value="1" min="1" readonly style="box-shadow: none; font-size: 1.05rem;" />
                                    <button type="button" id="btnPlus" class="btn btn-light h-100 border-0 rounded-circle fw-bold text-dark d-flex align-items-center justify-content-center p-0" style="width: 32px; font-size: 1.2rem;">+</button>
                                </div>

                                <button type="submit" id="modalBuyBtn" class="btn btn-primary flex-grow-1 rounded-pill py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2 transition-all">
                                    <i class="fas fa-cart-plus"></i> <span>Dodaj u korpu</span>
                                </button>
                            </form>

                            <button type="button" class="btn btn-light w-100 rounded-pill py-2 border fw-semibold text-muted close-modal-trigger" data-bs-dismiss="modal" data-dismiss="modal">
                                Zatvori pregled
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        var productModal = document.getElementById('productDetailsModal');

        if (productModal) {
            productModal.addEventListener('show.bs.modal', function (event) {
                var container = event.relatedTarget;

                var id = container.getAttribute('data-bs-id');
                var stockCount = parseInt(container.getAttribute('data-bs-stockcount')) || 0;
                var name = container.getAttribute('data-bs-name');
                var img = container.getAttribute('data-bs-img');
                var category = container.getAttribute('data-bs-category');
                var desc = container.getAttribute('data-bs-desc');
                var price = container.getAttribute('data-bs-price');
                var stockHtml = container.getAttribute('data-bs-stock');

                productModal.querySelector('#modalProductTitle').textContent = name;
                productModal.querySelector('#modalProductImg').src = img;
                productModal.querySelector('#modalProductCategory').textContent = category;
                productModal.querySelector('#modalProductDesc').textContent = desc;
                productModal.querySelector('#modalProductPrice').textContent = price;
                productModal.querySelector('#modalProductStock').innerHTML = stockHtml;

                productModal.querySelector('#modalProductId').value = id;

                var qtyInput = productModal.querySelector('#modalProductQty');
                var buyBtn = productModal.querySelector('#modalBuyBtn');

                if (stockCount > 0) {
                    qtyInput.max = stockCount;
                    qtyInput.value = 1;
                    buyBtn.removeAttribute('disabled');
                    buyBtn.innerHTML = '<i class="fas fa-cart-plus"></i> <span>Dodaj u korpu</span>';
                    buyBtn.className = "btn btn-primary flex-grow-1 rounded-pill py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2";
                } else {
                    qtyInput.value = 0;
                    buyBtn.setAttribute('disabled', 'disabled');
                    buyBtn.innerHTML = '<i class="fas fa-times-circle"></i> <span>Rasprodato</span>';
                    buyBtn.className = "btn btn-secondary flex-grow-1 rounded-pill py-2.5 fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2";
                }
            });
        }

        var btnMinus = document.getElementById('btnMinus');
        var btnPlus = document.getElementById('btnPlus');
        var qtyInput = document.getElementById('modalProductQty');

        if(btnMinus && btnPlus && qtyInput) {
            btnMinus.addEventListener('click', function(e) {
                e.preventDefault();
                var currentVal = parseInt(qtyInput.value) || 1;
                if (currentVal > 1) {
                    qtyInput.value = currentVal - 1;
                }
            });

            btnPlus.addEventListener('click', function(e) {
                e.preventDefault();
                var currentVal = parseInt(qtyInput.value) || 1;
                var maxVal = parseInt(qtyInput.max) || 999;
                if (currentVal < maxVal) {
                    qtyInput.value = currentVal + 1;
                }
            });
        }

        document.querySelectorAll('.close-modal-trigger').forEach(function(element) {
            element.addEventListener('click', function() {
                if (productModal) {
                    if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                        var modalInstance = bootstrap.Modal.getInstance(productModal);
                        if (modalInstance) modalInstance.hide();
                    }
                    setTimeout(function() {
                        productModal.classList.remove('show');
                        productModal.style.display = 'none';
                        document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                        document.body.classList.remove('modal-open');
                        document.body.style.overflow = '';
                        document.body.style.paddingRight = '';
                    }, 100);
                }
            });
        });

        // POPRAVLJEN I UNAPREĐEN AJAX ZA SLANJE TAČNE KOLIČINE I INSTANT APDEJT BROJAČA
        document.addEventListener('submit', function (e) {
            if (e.target && e.target.classList.contains('ajax-cart-form')) {
                e.preventDefault();

                var form = e.target;
                var submitBtn = form.querySelector('button[type="submit"]');
                var btnTextSpan = submitBtn.querySelector('span');
                var btnIcon = submitBtn.querySelector('i');

                var originalText = btnTextSpan ? btnTextSpan.textContent : "Kupi";
                var originalClass = submitBtn.className;
                var originalIconClass = btnIcon ? btnIcon.className : "";

                var qtyField = form.querySelector('input[name="quantity"]');
                var qtyValue = qtyField ? parseInt(qtyField.value) || 1 : 1;

                var formData = new FormData(form);

                fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(function (response) {
                    if (response.ok) {
                        submitBtn.classList.add('btn-success-animated');
                        if (btnTextSpan) btnTextSpan.textContent = "Dodato! ✓";
                        if (btnIcon) btnIcon.className = "fas fa-check";

                        // Pronalazi naš novi nepogrešivi brojač u Layoutu i osvežava ga bez refresha cele strane!
                        var customBadge = document.getElementById('globalCartCountBadge');
                        if (customBadge) {
                            var currentCount = parseInt(customBadge.textContent) || 0;
                            customBadge.textContent = currentCount + qtyValue;
                            customBadge.style.display = 'inline-block'; // Prikazuje ga ako je bio skriven (0)
                        }

                        setTimeout(function () {
                            submitBtn.className = originalClass;
                            if (btnTextSpan) btnTextSpan.textContent = originalText;
                            if (btnIcon) btnIcon.className = originalIconClass;
                        }, 2000);
                    } else {
                        alert("Greška prilikom dodavanja artikla u korpu.");
                    }
                })
                .catch(function (error) {
                    console.error("Greška:", error);
                });
            }
        });
    });
</script>