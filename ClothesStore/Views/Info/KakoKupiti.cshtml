@{
    ViewData["Title"] = "Kako kupiti";
}

<div class="p-4 bg-white rounded-4 shadow-sm transition-hover">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill uppercase fw-bold tracking-wider mb-2">Vodič</span>
        <h2 class="fw-bold text-dark">Kako kupiti na Clothes Store?</h2>
        <p class="text-muted">Kupovina kod nas je brza, jednostavna i potpuno sigurna. Pratite ova 4 laka koraka.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-3 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow" style="width: 60px; height: 60px; font-size: 1.5rem;">
                <i class="fas fa-search"></i>
            </div>
            <h5 class="fw-bold text-dark">1. Izaberite artikle</h5>
            <p class="small text-muted px-2">Prelistajte naše kategorije, izaberite željenu veličinu i količinu odeće, pa kliknite na dugme "Add To Cart".</p>
        </div>

        <div class="col-md-6 col-lg-3 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow" style="width: 60px; height: 60px; font-size: 1.5rem;">
                <i class="fas fa-shopping-basket"></i>
            </div>
            <h5 class="fw-bold text-dark">2. Pregledajte korpu</h5>
            <p class="small text-muted px-2">Kliknite na vašu korpu u gornjem desnom uglu kako biste proverili spisak izabranih stvari i krenuli na kasu.</p>
        </div>

        <div class="col-md-6 col-lg-3 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-primary text-white rounded-circle mb-3 shadow" style="width: 60px; height: 60px; font-size: 1.5rem;">
                <i class="fas fa-id-card"></i>
            </div>
            <h5 class="fw-bold text-dark">3. Unesite podatke</h5>
            <p class="small text-muted px-2">Upišite osnovne informacije za dostavu (ime, prezime, tačnu adresu i broj telefona) kako bismo znali gde šaljemo paket.</p>
        </div>

        <div class="col-md-6 col-lg-3 text-center">
            <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle mb-3 shadow" style="width: 60px; height: 60px; font-size: 1.5rem;">
                <i class="fas fa-check-double"></i>
            </div>
            <h5 class="fw-bold text-dark">4. Potvrdite porudžbinu</h5>
            <p class="small text-muted px-2">Završite kupovinu. Paket stiže na vašu kućnu adresu u roku od 24h do 48h, a plaćate kuriru gotovinom prilikom preuzimanja!</p>
        </div>
    </div>

    <div class="mt-5 p-3 bg-light rounded-3 d-flex align-items-center gap-3 border-start border-primary border-4">
        <i class="fas fa-truck text-primary fs-3"></i>
        <div class="small">
            <strong class="text-dark">Besplatna dostava:</strong> Za sve porudžbine preko 5.000 RSD, troškove brze pošte u potpunosti pokrivamo mi!
        </div>
    </div>
</div>