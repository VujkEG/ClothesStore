@using ClothesStore.Models
<!DOCTYPE html>
<html lang="sr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClothesStore</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        body {
            background-color: #f4f7f6;
            background-image: radial-gradient(at 0% 0%, rgba(219, 234, 254, 0.3) 0px, transparent 50%), radial-gradient(at 100% 100%, rgba(243, 232, 255, 0.3) 0px, transparent 50%);
            background-attachment: fixed;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .transition-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 1px solid rgba(0,0,0,0.03) !important;
        }

            .transition-hover:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.08) !important;
            }

        .main-container {
            flex: 1 0 auto;
        }

        .footer-modern {
            background: #111827;
            color: #d1d5db;
            flex-shrink: 0;
            border-top: 4px solid #3b82f6;
        }

            .footer-modern h5 {
                color: #ffffff;
                font-size: 1.05rem;
                position: relative;
                padding-bottom: 8px;
            }

                .footer-modern h5::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    bottom: 0;
                    width: 35px;
                    height: 2px;
                    background-color: #3b82f6;
                }

        .footer-link {
            color: #d1d5db;
            text-decoration: none;
            transition: all 0.2s ease;
            display: inline-block;
        }

            .footer-link:hover {
                color: #3b82f6;
                transform: translateX(5px);
            }

        .social-icon {
            width: 36px;
            height: 36px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #1f2937;
            color: #ffffff;
            margin-right: 10px;
            transition: all 0.3s ease;
        }

            .social-icon:hover {
                background: #3b82f6;
                color: #ffffff;
                transform: translateY(-3px);
            }

        .footer-contact-list {
            color: #e5e7eb !important;
        }

            .footer-contact-list li {
                display: flex;
                align-items: center;
                gap: 10px;
            }

        .payment-icons {
            font-size: 1.4rem;
            color: #6b7280;
            display: flex;
            gap: 12px;
            justify-content: center;
        }

        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        .user-dropdown .dropdown-menu {
            border: none;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
            background-color: #ffffff;
        }

        .user-dropdown .dropdown-item {
            transition: all 0.2s;
        }

            .user-dropdown .dropdown-item:hover {
                background-color: #f3f4f6;
                color: #111827;
            }
    </style>
</head>
<body class="d-flex flex-column">

    <div class="bg-dark text-white p-2 shadow-sm sticky-top" style="background-color: #111827 !important; z-index: 1050; top: 0;">
        <div class="container border-0">
            <div class="row align-items-center">
                <div class="col text-start">
                    <a href="/" class="navbar-brand text-white fw-bold text-uppercase tracking-wider fs-4">
                        <i class="fas fa-shopping-bag me-2 text-primary"></i> Clothes <span class="text-primary">Store</span>
                    </a>
                </div>
                <div class="col text-end d-flex align-items-center justify-content-end gap-2">

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (User.IsInRole("Admins") || string.Equals(User.Identity.Name, "Admin", StringComparison.OrdinalIgnoreCase) || string.Equals(User.Identity.Name, "Administrator", StringComparison.OrdinalIgnoreCase))
                        {
                            <a href="/admin/products" class="btn btn-sm btn-warning rounded-pill px-3 fw-bold text-uppercase tracking-wider shadow-sm me-1" style="font-size: 0.75rem; background-color: #f59e0b; border: none; color: #111827;">
                                <i class="fas fa-user-shield me-1"></i> Kontrolna tabla
                            </a>
                        }

                        <div class="dropdown user-dropdown">
                            <button class="btn btn-sm btn-outline-light rounded-pill dropdown-toggle px-3 d-flex align-items-center gap-2" type="button" id="userDropdownMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-circle text-primary fs-5"></i>
                                <span class="fw-semibold">@User.Identity.Name</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end p-2" aria-labelledby="userDropdownMenu">
                                <li class="px-3 py-2 border-bottom mb-1">
                                    <small class="text-muted d-block">Prijavljeni ste kao</small>
                                    <strong class="text-dark small text-truncate d-block">@User.Identity.Name</strong>
                                </li>
                                <li>
                                    <a class="dropdown-item rounded-3 small py-2 text-danger" href="/Account/Logout">
                                        <i class="fas fa-sign-out-alt me-2"></i>Odjavi se
                                    </a>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2">
                            <a href="/Account/Login" class="btn btn-sm btn-outline-light rounded-pill px-3 fw-semibold text-uppercase tracking-wider" style="font-size: 0.75rem;">
                                <i class="fas fa-sign-in-alt me-1"></i> Prijava
                            </a>
                            <a href="/Account/Register" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold text-uppercase tracking-wider shadow-sm" style="font-size: 0.75rem; background-color: #3b82f6; border: none;">
                                <i class="fas fa-user-plus me-1"></i> Registracija
                            </a>
                        </div>
                    }

                    @await Component.InvokeAsync("CartSummary")
                </div>
            </div>
        </div>
    </div>

    <div class="container main-container mt-4 mb-5">
        <div class="row g-4">
            <div id="categories" class="col-lg-3">
                <div class="p-3 bg-white rounded-4 shadow-sm sticky-md-top" style="top: 75px; z-index: 10;">
                    <h5 class="fw-bold mb-3 text-secondary px-2 small text-uppercase tracking-wide">Kategorije</h5>
                    @await Component.InvokeAsync("NavigationMenu")
                </div>
            </div>
            <div class="col-lg-9">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="footer-modern pt-4 pb-2">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-6 col-lg-4">
                    <h5 class="fw-bold text-uppercase mb-2 tracking-wider">Clothes Store</h5>
                    <p class="small lh-base m-0">Pronađite najnovije trendove muške i ženske odeće na jednom mestu. Garantujemo vrhunski kvalitet, brzu isporuku i sigurno online plaćanje.</p>
                    <div class="mt-2">
                        <a href="https://facebook.com" target="_blank" class="social-icon"><i class="fab fa-facebook-f"></i></a>
                        <a href="https://instagram.com" target="_blank" class="social-icon"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>

                <div class="col-6 col-lg-2 offset-lg-1">
                    <h5 class="fw-bold text-uppercase mb-2 tracking-wider">Kupovina</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-1 m-0">
                        <li><a href="/" class="footer-link"><i class="fas fa-chevron-right me-1 small"></i> Svi proizvodi</a></li>
                        <li><a href="/Cart" class="footer-link"><i class="fas fa-chevron-right me-1 small"></i> Moja korpa</a></li>
                    </ul>
                </div>

                <div class="col-6 col-lg-2">
                    <h5 class="fw-bold text-uppercase mb-2 tracking-wider">Podrška</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-1 m-0">
                        <li><a href="/Info/KakoKupiti" class="footer-link"><i class="fas fa-chevron-right me-1 small"></i> Kako kupiti?</a></li>
                        <li><a href="/Info/PovracajRobe" class="footer-link"><i class="fas fa-chevron-right me-1 small"></i> Povraćaj robe</a></li>
                        <li><a href="/Info/UsloviKoriscenja" class="footer-link"><i class="fas fa-chevron-right me-1 small"></i> Uslovi korišćenja</a></li>
                    </ul>
                </div>

                <div class="col-md-6 col-lg-3">
                    <h5 class="fw-bold text-uppercase mb-2 tracking-wider">Kontakt</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2 text-white m-0 footer-contact-list">
                        <li><i class="fas fa-map-marker-alt text-primary"></i> <span>Terazije 15, Beograd</span></li>
                        <li><i class="fas fa-phone text-primary"></i> <span>+381 11 123 4567</span></li>
                        <li><i class="fas fa-envelope text-primary"></i> <span>podrska@clothesstore.com</span></li>
                        <li><i class="fas fa-clock text-primary"></i> <span>Pon-Pet: 09:00 - 21:00</span></li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary my-3 opacity-25">

            <div class="row align-items-center py-1">
                <div class="col-md-6 text-center text-md-start small mb-1 mb-md-0">
                    &copy; 2026 ClothesStore. Sva prava zadržana.
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="payment-icons justify-content-md-end">
                        <i class="fab fa-cc-visa" title="Visa"></i>
                        <i class="fab fa-cc-mastercard" title="Mastercard"></i>
                        <i class="fab fa-cc-paypal" title="PayPal"></i>
                        <i class="fas fa-money-bill-wave" title="Plaćanje pouzećem"></i>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    <script src="/lib/jquery/dist/jquery.min.js"></script>
    <script src="/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.server.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".btn-plus").forEach(button => {
                button.addEventListener("click", function () {
                    const id = this.getAttribute("data-id");
                    const input = document.getElementById("quantity-" + id);
                    const formInput = document.getElementById("form-quantity-" + id);
                    const max = parseInt(input.getAttribute("max")) || 999;
                    let val = parseInt(input.value);
                    if (val < max) {
                        val++;
                        input.value = val;
                        if(formInput) formInput.value = val;
                    }
                });
            });

            document.querySelectorAll(".btn-minus").forEach(button => {
                button.addEventListener("click", function () {
                    const id = this.getAttribute("data-id");
                    const input = document.getElementById("quantity-" + id);
                    const formInput = document.getElementById("form-quantity-" + id);
                    let val = parseInt(input.value);
                    if (val > 1) {
                        val--;
                        input.value = val;
                        if(formInput) formInput.value = val;
                    }
                });
            });

            document.addEventListener("submit", function (e) {
                if (e.target && e.target.classList.contains("ajax-cart-form")) {
                    e.preventDefault();
                    const form = e.target;
                    const formData = new FormData(form);

                    fetch(form.action, {
                        method: "POST",
                        body: formData,
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    })
                    .then(response => response.json())
                    .then(data => {
                        const badge = document.getElementById("cart-badge");
                        const total = document.getElementById("cart-total");
                        const infoText = document.querySelector(".cart-info-text");

                        if (badge && total) {
                            badge.textContent = data.linesCount + " artikal(a)";
                            total.textContent = data.totalValue;
                            if (infoText) {
                                infoText.style.setProperty("display", "inline", "important");
                            }

                            const cartWrapper = document.getElementById("cart-summary-wrapper");
                            if (cartWrapper) {
                                cartWrapper.style.transform = "scale(1.1)";
                                cartWrapper.style.transition = "transform 0.15s ease-in-out";
                                setTimeout(() => { cartWrapper.style.transform = "scale(1)"; }, 150);
                            }
                        }
                    })
                    .catch(error => console.error("Greška:", error));
                }
            });
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>